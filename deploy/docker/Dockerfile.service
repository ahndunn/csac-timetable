# syntax=docker/dockerfile:1.7
ARG SERVICE_NAME=scheduler-service

# 1. Planner stage: computes the recipe manifest for dependency caching
FROM docker.io/lukemathwalker/cargo-chef:latest-rust-1-bookworm AS planner
WORKDIR /app
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# 2. Builder stage: compiles dependencies first (cached), then compiles source code
FROM docker.io/lukemathwalker/cargo-chef:latest-rust-1-bookworm AS builder
ARG SERVICE_NAME
WORKDIR /app

# Install native dependencies required for protoc / gRPC and native SSL/Kafka bindings
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    libssl-dev \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV PROTOC=/usr/bin/protoc

# Pre-cook and cache external dependencies layer
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --release --recipe-path recipe.json --bin ${SERVICE_NAME}

# Copy workspace source and compile only the targeted binary
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --bin ${SERVICE_NAME} && \
    strip /app/target/release/${SERVICE_NAME} && \
    cp /app/target/release/${SERVICE_NAME} /app/service-bin

# 3. Minimal Production Runner Stage
FROM docker.io/library/debian:bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/service-bin /usr/local/bin/service

USER 10001:10001
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/service"]
